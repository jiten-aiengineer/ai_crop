GPU_TRAINER_TOKEN=replace-with-a-random-value-of-at-least-32-characters
GPU_TRAINER_STATE_DIR=/var/lib/crop-life-ai-gpu-trainer
GPU_TRAINER_ALLOWED_BUCKETS=crop-life-ai-data
GPU_TRAINER_MAX_EXAMPLES=1000
GPU_TRAINER_MIN_FREE_GB=12
GPU_TRAINER_MAX_IMAGE_MB=25
# Train from the original Transformers checkpoint, never from the Ollama Q4 GGUF.
GPU_HF_BASE_MODEL=Qwen/Qwen3.5-9B
GPU_TRAINER_EPOCHS=1
GPU_TRAINER_MAX_LENGTH=1024
HF_HOME=/opt/dlami/nvme/crop-life-ai-training/cache/huggingface
XDG_CACHE_HOME=/opt/dlami/nvme/crop-life-ai-training/cache/xdg
TRITON_CACHE_DIR=/opt/dlami/nvme/crop-life-ai-training/cache/triton
TORCHINDUCTOR_CACHE_DIR=/opt/dlami/nvme/crop-life-ai-training/cache/torchinductor
# This is parsed as an argument vector; no shell expansion is performed.
GPU_TRAINER_COMMAND=/opt/crop-life-ai/train-venv/bin/python /opt/crop-life-ai/gpu-trainer/training/train_qwen_adapter.py
GPU_PROMOTION_COMMAND=/opt/crop-life-ai/train-venv/bin/python /opt/crop-life-ai/gpu-trainer/training/promote_qwen_adapter.py
