GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
POSTGRES_DB=crop_life_ai
POSTGRES_USER=crop_life
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5434
INITIAL_ADMIN_EMPLOYEE_CODE=CLSL-1415
INITIAL_ADMIN_EMAIL=aiengineer.2@croplifescience.com

# Private AI evaluation: disabled until the private service is configured.
GEMINI_ENABLED=true
GEMINI_MODEL=
# Private inspection image archive. Configure on the EC2 server only; never add
# AWS access keys because the AWS SDK uses the attached EC2 IAM role.
AWS_REGION=
S3_BUCKET_NAME=
S3_INSPECTIONS_PREFIX=inspections
# Private host-to-container persistence endpoint. The token is an internal
# application secret, not an AWS credential, and should remain blank in Git.
INSPECTION_PERSISTENCE_URL=
INSPECTION_PERSISTENCE_TOKEN=
QWEN_ENABLED=false
QWEN_SHADOW_MODE=false
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen3.5:9b
QWEN_TIMEOUT_SECONDS=180
COMPARISON_SERVICE_URL=
COMPARISON_SERVICE_TOKEN=
COMPARISON_ADMIN_TOKEN=
COMPARISON_DB_PATH=
