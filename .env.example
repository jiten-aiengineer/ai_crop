GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
POSTGRES_DB=crop_life_ai
POSTGRES_USER=crop_life
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5434
INITIAL_ADMIN_EMPLOYEE_CODE=CLSL-1415
INITIAL_ADMIN_EMAIL=aiengineer.2@croplifescience.com

# Private AI evaluation: disabled until the private service is configured.
GEMINI_ENABLED=true
GEMINI_MODEL=
# Private inspection image archive. Configure on the EC2 server only; never add
# AWS access keys because the AWS SDK uses the attached EC2 IAM role.
AWS_REGION=
S3_BUCKET_NAME=
S3_INSPECTIONS_PREFIX=inspections
S3_PRODUCT_IMAGES_PREFIX=product-images
# Private host-to-container persistence endpoint. The token is an internal
# application secret, not an AWS credential, and should remain blank in Git.
INSPECTION_PERSISTENCE_URL=
INSPECTION_PERSISTENCE_TOKEN=
# Optional dedicated token. If blank, the persistence token is reused for the
# internal catalogue recommendation service.
INTERNAL_SERVICE_TOKEN=
CATALOG_RECOMMENDATION_URL=
# Optional. If omitted, the app derives this from CATALOG_RECOMMENDATION_URL.
# This endpoint is used only server-to-server for the live farmer catalogue
# and Gemini RAG context; never expose its token in the browser.
CATALOGUE_PRODUCTS_URL=

# Secure administration portal. Temporary password sign-in is permitted only
# on a valid HTTPS hostname and must be replaced by Microsoft Entra sign-in.
# Store only a salted scrypt hash, never TEMP_ADMIN_PASSWORD in this file.
ADMIN_PORTAL_HOSTNAME=
ADMIN_PORTAL_ORIGIN=
ADMIN_PORTAL_SESSION_SECRET=
TEMP_ADMIN_USERNAME=
TEMP_ADMIN_EMAIL=
TEMP_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<base64url-salt>$<base64url-derived-key>
# Legacy test accounts are supported only during migration. New access is
# issued by official employee email from Access & hierarchy in the portal.
TEMP_DEMO_ACCOUNTS_JSON=[]
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ADMIN_ALLOWED_EMAIL_DOMAIN=croplifescience.com
ADMIN_GATEWAY_TOKEN=
PORTAL_INVITE_EMAIL_FROM=aiengineer.2@croplifescience.com
PORTAL_INVITE_URL=https://croplifescience.duckdns.org/admin/portal
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
QWEN_ENABLED=false
QWEN_SHADOW_MODE=false
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen3.5:9b
QWEN_TIMEOUT_SECONDS=180
QWEN_KEEP_ALIVE=3h
QWEN_MAX_ATTEMPTS=3
QWEN_WORKER_POLL_SECONDS=10
QWEN_PROCESSING_WINDOW_ENABLED=true
QWEN_WINDOW_START=20:00
QWEN_WINDOW_END=22:30
QWEN_TIMEZONE=Asia/Kolkata
QWEN_GPU_INSTANCE_ID=
QWEN_EARLY_STOP_ENABLED=false
QWEN_IDLE_STOP_SECONDS=300
QWEN_SCHEDULE_AUTOMATION=not_configured
COMPARISON_SERVICE_URL=
COMPARISON_SERVICE_TOKEN=
COMPARISON_ADMIN_TOKEN=
COMPARISON_DB_PATH=
