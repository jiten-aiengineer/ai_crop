{
  "expo": {
    "name": "CLSL AI",
    "slug": "jitenclsl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/clsl-logo.png",
    "scheme": "clslai",
    "userInterfaceStyle": "light",
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.croplifescience.clslai",
      "adaptiveIcon": {
        "backgroundColor": "#064878",
        "foregroundImage": "./assets/images/clsl-logo.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.croplifescience.clslai",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CLSL AI to photograph crops and scan CLSL QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CLSL AI to show local weather and save your district for crop support."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3aa664f1-6847-4ce9-99da-5c1bf1b8d266"
      }
    },
    "owner": "jitenclsls-team"
  }
}
