{
  "expo": {
    "name": "CLSL AI",
    "slug": "clsl-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/clsl-logo.png",
    "scheme": "clslai",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.croplifescience.clslai",
      "adaptiveIcon": {
        "backgroundColor": "#064878",
        "foregroundImage": "./assets/images/clsl-logo.png"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "com.croplifescience.clslai",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#064878",
          "image": "./assets/images/clsl-logo.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CLSL AI to photograph crops and scan CLSL QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CLSL AI to show local weather and save your district for crop support."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
