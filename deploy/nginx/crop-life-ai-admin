server {
    # Temporary IP-based administration entry. Use HTTPS and hostname routing
    # once the Crop Life domain is available.
    listen 8080;
    server_name _;
    client_max_body_size 5m;

    location = / {
        return 302 /admin/portal;
    }

    # The portal needs its framework assets and approved package images, but
    # no farmer-facing page routes are exposed from this temporary listener.
    location ~ ^/(admin/|api/admin/|_next/|products/|clsl-logo\.png$|manifest\.webmanifest$) {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
