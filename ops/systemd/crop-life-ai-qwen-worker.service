[Unit]
Description=Crop Life AI private Qwen shadow evaluation worker
Documentation=https://croplifescience.duckdns.org/admin/portal
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/ai_crop
EnvironmentFile=/home/ubuntu/apps/ai_crop/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/ai_crop/.venv-qwen-worker/bin/python -m backend.app.qwen_worker
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
